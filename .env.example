# geo-agent deployment knobs. docker compose reads this file for the
# ${VAR:-default} substitutions in docker-compose.yml — copy to .env and
# set what differs from the defaults. Everything has a working default;
# an empty .env is a valid deployment.

# ── Data ────────────────────────────────────────────────────────────
# Host directory mounted at /app/data inside the backend: offline
# assets under <dir>/offline (OSM-derived roads/builtup/forest/water
# for offline_mode loaders), persisted renders under <dir>/renders
# (POST /render persist:true → GET /render/latest/{map_uuid}.jpg).
# Spark points this at the asset stash (~/pytho-data/geo-agent);
# default is the in-repo ./data.
GEO_DATA_DIR=./data

# Offline asset loaders on/off.
OFFLINE_MODE=false

# ── Render (the export pipeline) ────────────────────────────────────
# CDP endpoint of the host-side GPU Chromium (see infra/host/README.md;
# installed by scripts/install_geoagent.sh --host-render). The compose
# default is the docker bridge address the cdp-forward service listens
# on. On a host WITHOUT GPU Chromium (cloud EC2, laptops), set it EMPTY —
# the backend then launches the Chromium baked into its own image
# (SwiftShader WebGL, CPU-speed, correct output):
# PYTHO_RENDER_CDP=
PYTHO_RENDER_CDP=http://172.17.0.1:9222

# Origin the render Chromium loads /geo-app/headless from. Unset, the
# backend picks by mode: CDP mode uses https://localhost (a consumer
# nginx on the shared host terminating TLS on 443); in-container mode
# uses http://127.0.0.1:8000 (the browser runs inside the backend
# container and hits uvicorn directly). Only set this to override both.
# GEO_AGENT_RENDER_HOST_BASE=https://localhost

# Parallel render pages. RENDER_WEBGL applies to the in-container
# browser only: "swiftshader" (alias "software") forces SwiftShader even
# when a GPU is visible; "hardware" lets Chromium pick (a GPU-less
# container lands on SwiftShader anyway). The host-CDP Chromium owns its
# own GL flags (infra/host/playwright_server.py).
RENDER_CONCURRENCY=4
RENDER_WEBGL=hardware

# ── CORS (bare-backend dev only) ────────────────────────────────────
# Production consumers are same-origin through their own nginx and
# never need CORS. For direct-origin dev, set an exact list AND/OR a
# single regex; a request's Origin is allowed if it matches either.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Airgapped LAN (analyst PCs on RFC 1918 subnets, can't enumerate IPs):
# ALLOWED_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1|10\.[0-9.]+|192\.168\.[0-9.]+|172\.(1[6-9]|2[0-9]|3[01])\.[0-9.]+)(:[0-9]+)?$

# ── NL agent (optional) ─────────────────────────────────────────────
# AWS credentials for Bedrock (the nl/* endpoints); unset disables NL.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3 artifact storage (optional — local storage without it).
AWS_S3_BUCKET=
# OpenWeatherMap key — drives the analyst weather overlay (forecast
# raster tiles proxied through /tiles/weather so the key never reaches
# a browser) AND weather-aware terrain/route scoring. Optional: without
# it the weather layer buttons 503 cleanly and scoring skips.
OWM_API_KEY=

# ── First-open camera (optional) ────────────────────────────────────
# Per-deployment default view "lng,lat,zoom", served via /config and
# used when a map has no saved viewport yet (fresh stacks, new project
# maps). Unset falls back to a neutral world view.
# DEFAULT_VIEW=26.82,57.96,8.87
DEFAULT_VIEW=

# ── NOT knobs ───────────────────────────────────────────────────────
# DATABASE_URL and TILECACHE_URL are wired by docker-compose to the
# stack's own containers (db:5432, tilecache:8080) — set them only when
# running the backend bare (uvicorn outside compose) against external
# services.
